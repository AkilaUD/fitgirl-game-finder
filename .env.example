# Copy to .env and fill in. scripts/serve.mjs reads this file.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO=nexorasoftwarestudio@gmail.com
CONTACT_FROM=Repack Finder <onboarding@resend.dev>

# Upstash Redis — required for PC scan pairing on Vercel / local serve
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# Pairing session TTL (seconds, default 300)
PC_SCAN_PAIR_TTL_SEC=300

# Comma-separated origins allowed for pair/consume (browser). Example:
# ALLOWED_ORIGINS=https://fitgirl-game-finder.vercel.app,http://localhost:5173

# GitHub Releases installer URL (also set VITE_SCANNER_DOWNLOAD_URL for the React build)
SCANNER_DOWNLOAD_URL=https://github.com/AkilaUD/fitgirl-game-finder/releases/latest/download/FitGirlPcScanner-setup.exe

# Vite (prefix VITE_ for client exposure; optional — UI falls back to GitHub Releases)
VITE_SCANNER_DOWNLOAD_URL=https://github.com/AkilaUD/fitgirl-game-finder/releases/latest/download/FitGirlPcScanner-setup.exe