{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/scanner-download.js": {
      "includeFiles": "public/downloads/FitGirlPcScanner-portable.zip"
    }
  },
  "headers": [
    {
      "source": "/downloads/(.*\\.(exe|zip))",
      "headers": [{ "key": "Content-Disposition", "value": "attachment" }]
    }
  ],
  "rewrites": [{ "source": "/((?!api/|downloads/).*)", "destination": "/index.html" }]
}