{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/downloads/FitGirlPcScanner-setup.exe",
      "headers": [{ "key": "Content-Disposition", "value": "attachment" }]
    },
    {
      "source": "/downloads/FitGirlPcScanner-portable.zip",
      "headers": [{ "key": "Content-Disposition", "value": "attachment" }]
    }
  ],
  "rewrites": [{ "source": "/((?!api/|downloads/).*)", "destination": "/index.html" }]
}