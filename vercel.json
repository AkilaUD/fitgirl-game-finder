{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/contact.js": { "maxDuration": 15 },
    "api/stats.js": { "maxDuration": 15 },
    "api/pc-scan.js": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/downloads/FitGirlPcScanner-setup.exe",
      "headers": [{ "key": "Content-Disposition", "value": "attachment" }]
    },
    {
      "source": "/downloads/FitGirlPcScanner-portable.zip",
      "headers": [{ "key": "Content-Disposition", "value": "attachment" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/pc-scan/:action",
      "destination": "/api/pc-scan?action=:action"
    },
    {
      "source": "/api/stats/record",
      "destination": "/api/stats?record=1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}